MODELARTS_COHORT_ID=<UNIQUE_ROLLOUT_ID>

# Set exactly one role on each ModelArts inference unit:
# P_ENTRY: one instance; API proxy plus the first Prefill rank
# P_WORKER: three instances
# D_WORKER: four instances
# GLM52_ROLE=P_ENTRY

MODEL_PATH=/model/weight
SCRIPT_PATH=/cache/scripts
LOG_PATH=/logs
RENDEZVOUS_ROOT=/logs/rendezvous

SERVED_MODEL_NAME=glm-5.2
PROXY_PORT=8000
PREDICT_PORT=1025
DP_RPC_PORT=12345

PREFILL_DP_SIZE=4
PREFILL_TP_SIZE=8
DECODE_DP_SIZE=4
DECODE_TP_SIZE=8
MAX_MODEL_LEN=1048576
PREFILL_MAX_BATCHED_TOKENS=8192
DECODE_MAX_BATCHED_TOKENS=256
MAX_NUM_SEQS=8
PREFILL_GPU_MEMORY_UTILIZATION=0.95
DECODE_GPU_MEMORY_UTILIZATION=0.90
PREFILL_MTP_TOKENS=1
DECODE_MTP_TOKENS=3

MOONCAKE_CONFIG_PATH=/cache/config/mooncake.json
LAUNCH_ONLINE_DP_SCRIPT=/vllm-workspace/vllm-ascend/examples/external_online_dp/launch_online_dp.py
LOAD_BALANCE_PROXY_SCRIPT=/vllm-workspace/vllm-ascend/examples/disaggregated_prefill_v1/load_balance_proxy_server_example.py
